+import { Link } from 'react-router-dom'
+import { useClub, useClubEvent } from '../lib/club'
+import { useAsync } from '../lib/hooks'
+import './HomeWeeklySummary.css'
+
+/** 와이어 홈 상단의 공개 요약. 인원은 활동 멤버, 일정/기사는 이번 주(월~일) 기준. */
+export function HomeWeeklySummary() {
+  const { api, slug } = useClub()
+  const summary = useAsync(() => api.clubSummary(), [api])
+
+  useClubEvent((event) => {
+    if (
+      event.type === 'SESSION_UPDATED' ||
+      event.type === 'ARTICLE_UPDATED' ||
+      event.type === 'TEAMS_UPDATED'
+    ) {
+      summary.reload()
+    }
+  })
+
+  const items = [
+    {
+      label: '멤버',
+      count: summary.data?.activeMembers,
+      to: `/c/${slug}/members`,
+      ariaLabel: '멤버 목록인 선수단 페이지로 이동',
+    },
+    {
+      label: '이번 주 일정',
+      count: summary.data?.sessions,
+      to: `/c/${slug}/sessions`,
+      ariaLabel: '일정 목록으로 이동',
+    },
+    {
+      label: '이번 주 기사',
+      count: summary.data?.articles,
+      to: `/c/${slug}#wire-title`,
+      ariaLabel: '와이어 기사 영역으로 이동',
+    },
+  ]
+
+  return (
+    <nav className="home-weekly-summary" aria-label="클럽 요약 바로가기">
+      {items.map(({ label, count, to, ariaLabel }) => (
+        <Link key={label} to={to} className="home-weekly-summary__link" aria-label={ariaLabel}>
+          <strong className="home-weekly-summary__count">
+            {summary.loading && !summary.data ? '–' : count ?? '–'}
+          </strong>
+          <span className="home-weekly-summary__label">{label}</span>
+        </Link>
+      ))}
+    </nav>
+  )
+}
