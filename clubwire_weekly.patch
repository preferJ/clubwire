+/* 기존 클럽 테마를 상속받는 홈 상단의 3칸 요약 링크 */
+.home-weekly-summary {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  border-top: 1px solid var(--line, #393d44);
+  border-bottom: 1px solid var(--line, #393d44);
+}
+.home-weekly-summary__link {
+  display: flex;
+  min-width: 0;
+  min-height: 64px;
+  padding: 9px 5px;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  gap: 2px;
+  color: inherit;
+  text-align: center;
+  text-decoration: none;
+  transition: background .15s ease;
+}
+.home-weekly-summary__link + .home-weekly-summary__link {
+  border-left: 1px solid var(--line, #393d44);
+}
+.home-weekly-summary__link:hover {
+  background: rgba(127, 127, 127, .10);
+  color: inherit;
+}
+.home-weekly-summary__link:focus-visible {
+  outline: 2px solid var(--green, #0f6b4f);
+  outline-offset: -2px;
+}
+.home-weekly-summary__count {
+  font-size: 17px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1.2;
+}
+.home-weekly-summary__label {
+  font-size: 12px;
+  opacity: .8;
+}
