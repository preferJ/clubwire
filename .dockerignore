# Allow only source files used by the multi-stage image.
**
!Dockerfile
!requirements.txt
!alembic.ini
!app/
!app/**
!alembic/
!alembic/**
!scripts/
!scripts/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**

# Never send local credentials, dependencies, generated data or backups.
**/.env
**/.env.*
**/oracle.env
**/*-backups/
**/__pycache__/
**/*.pyc
**/node_modules/
**/.venv/
**/*.sql
**/*.zip
**/*.log
