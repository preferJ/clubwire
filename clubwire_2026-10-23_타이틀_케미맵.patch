diff --git a/frontend/src/components/ChemistryMap.tsx b/frontend/src/components/ChemistryMap.tsx
new file mode 100644
index 0000000..8a10c38
--- /dev/null
+++ b/frontend/src/components/ChemistryMap.tsx
@@ -0,0 +1,142 @@
+// 케미 맵: 나를 가운데 두고 위쪽 반원 = 자주 같은 팀이 된 선수, 아래쪽 반원 = 자주 맞붙은 선수(각 최대 5명).
+// 선 굵기 = 함께 · 맞붙은 경기 수, 색 = 승률 3단계(파랑 높음 · 회색 보통 · 주황 낮음 — 색약에도 구분되는 짝).
+// 색만으로 읽지 않게 이름 아래에 숫자(경기 수 · 승률 / 승 무 패)를 같이 쓰고, 정확한 값은 아래 [목록으로 보기]에 둔다.
+
+import { Link } from 'react-router-dom'
+import { initials } from '../lib/format'
+
+export interface MateLink {
+  memberId: number
+  name: string | null
+  matches: number
+  wins: number
+  draws: number
+  winRate: number | null
+}
+
+export interface RivalLink {
+  memberId: number
+  name: string | null
+  matches: number
+  wins: number
+  draws: number
+  losses: number
+}
+
+type Tier = 'hi' | 'mid' | 'lo'
+/** 승률 3단계: 50% 이상 높음, 30% 미만 낮음(3팀 풋살은 무승부가 많아 평균 승률이 35~40%대) */
+const HI = 0.5
+const LO = 0.3
+const TIER_LABEL: Record<Tier, string> = { hi: '승률 50%↑', mid: '30~50%', lo: '30%↓' }
+
+const W = 360
+const H = 400
+const CX = 180
+const CY = 200
+const R = 130
+const NODE = 19
+const MAX = 5
+
+function tierOf(rate: number | null): Tier {
+  if (rate === null) return 'mid'
+  return rate >= HI ? 'hi' : rate < LO ? 'lo' : 'mid'
+}
+
+/** 반원 위에 n개를 고르게: 위쪽은 200°~340°, 아래쪽은 20°~160°(화면 좌표, y가 아래로) */
+function angles(n: number, side: 'top' | 'bottom'): number[] {
+  const [from, to] = side === 'top' ? [200, 340] : [160, 20]
+  if (n === 1) return [side === 'top' ? 270 : 90]
+  return Array.from({ length: n }, (_, i) => from + ((to - from) * i) / (n - 1))
+}
+
+interface Node {
+  id: number
+  name: string
+  x: number
+  y: number
+  side: 'top' | 'bottom'
+  width: number
+  tier: Tier
+  stat: string
+  title: string
+}
+
+export function ChemistryMap({ slug, me, teammates, opponents }: {
+  slug: string
+  me: string
+  teammates: MateLink[]
+  opponents: RivalLink[]
+}) {
+  const mates = teammates.slice(0, MAX)
+  const rivals = opponents.slice(0, MAX)
+  const maxMatches = Math.max(1, ...mates.map((m) => m.matches), ...rivals.map((m) => m.matches))
+  const width = (m: number) => 2 + 6 * (m / maxMatches)
+  const pos = (deg: number) => ({ x: CX + R * Math.cos((deg * Math.PI) / 180), y: CY + R * Math.sin((deg * Math.PI) / 180) })
+
+  const nodes: Node[] = [
+    ...mates.map((m, i): Node => {
+      const p = pos(angles(mates.length, 'top')[i])
+      const rate = m.winRate ?? (m.matches ? m.wins / m.matches : null)
+      const losses = m.matches - m.wins - m.draws
+      return {
+        id: m.memberId, name: m.name ?? '', ...p, side: 'top', width: width(m.matches), tier: tierOf(rate),
+        stat: `${m.matches}경기 · ${rate === null ? '-' : Math.round(rate * 100)}%`,
+        title: `${m.name}: 같은 팀 ${m.matches}경기, ${m.wins}승 ${m.draws}무 ${losses}패`,
+      }
+    }),
+    ...rivals.map((m, i): Node => {
+      const p = pos(angles(rivals.length, 'bottom')[i])
+      return {
+        id: m.memberId, name: m.name ?? '', ...p, side: 'bottom', width: width(m.matches),
+        tier: tierOf(m.matches ? m.wins / m.matches : null),
+        stat: `${m.wins}승 ${m.draws}무 ${m.losses}패`,
+        title: `${m.name} 상대로 ${m.matches}경기 ${m.wins}승 ${m.draws}무 ${m.losses}패`,
+      }
+    }),
+  ]
+  if (!nodes.length) return <p className="small muted">기록이 쌓이면 보여요.</p>
+
+  const summary = `${me}의 케미 맵. 자주 같은 팀: ${mates.map((m) => `${m.name} ${m.matches}경기`).join(', ') || '없음'}. `
+    + `자주 맞붙은 선수: ${rivals.map((m) => `${m.name} ${m.wins}승 ${m.draws}무 ${m.losses}패`).join(', ') || '없음'}.`
+
+  return (
+    <figure className="chem">
+      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary}>
+        {/* 가운데 구분선 + 위/아래 이름표 */}
+        <line x1={8} y1={CY} x2={CX - 34} y2={CY} className="chem-divider" />
+        <line x1={CX + 34} y1={CY} x2={W - 8} y2={CY} className="chem-divider" />
+        <text x={10} y={CY - 8} className="chem-side">▲ 같은 팀</text>
+        <text x={10} y={CY + 18} className="chem-side">▼ 맞대결</text>
+
+        {nodes.map((n) => (
+          <line key={`l${n.side}${n.id}`} x1={CX} y1={CY} x2={n.x} y2={n.y} strokeWidth={n.width}
+            className={`chem-link ${n.tier}`} />
+        ))}
+
+        <circle cx={CX} cy={CY} r={27} className="chem-me" />
+        <text x={CX} y={CY + 5} textAnchor="middle" className="chem-me-text">{initials(me)}</text>
+
+        {nodes.map((n) => {
+          const up = n.side === 'top'
+          const nameY = up ? n.y - NODE - 20 : n.y + NODE + 15
+          const statY = up ? n.y - NODE - 5 : n.y + NODE + 30
+          return (
+            <Link key={`n${n.side}${n.id}`} to={`/c/${slug}/members/${n.id}`} className="chem-node" aria-label={n.title}>
+              <title>{n.title}</title>
+              <circle cx={n.x} cy={n.y} r={NODE} className={`chem-dot ${n.tier}`} />
+              <text x={n.x} y={n.y + 4} textAnchor="middle" className="chem-ini">{initials(n.name)}</text>
+              <text x={n.x} y={nameY} textAnchor="middle" className="chem-name">{n.name}</text>
+              <text x={n.x} y={statY} textAnchor="middle" className="chem-stat">{n.stat}</text>
+            </Link>
+          )
+        })}
+      </svg>
+      <figcaption className="chem-legend">
+        <span className="chem-key"><i className="w" />선 굵기 = 경기 수</span>
+        {(['hi', 'mid', 'lo'] as Tier[]).map((t) => (
+          <span key={t} className="chem-key"><i className={`c ${t}`} />{TIER_LABEL[t]}</span>
+        ))}
+      </figcaption>
+    </figure>
+  )
+}
