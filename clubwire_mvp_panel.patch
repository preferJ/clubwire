-/* MVP RACE(이달의 MVP 후보) */
+/* MVP RACE(이달의 MVP 후보): 전체 영역에서 MVP 기사 필터로 이동 */
+.mvp-panel { position: relative; }
+.mvp-panel .panel-head { padding: 12px 18px; }
+.mvp-panel .panel-body { min-height: 90px; padding: 18px; justify-content: center; }
+.mvp-panel .panel-note { padding: 12px 18px; }
+.mvp-panel-link { display: block; color: inherit; }
+.mvp-panel-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
+.mvp-panel:focus-within { outline: 2px solid var(--accent-ink); outline-offset: 2px; }
+.mvp-panel:hover { border-color: var(--line-strong); }
+.mvp-panel-error button { position: relative; z-index: 2; }
 .race { list-style: none; margin: 0; padding: 0; }
-.race-row { display: flex; align-items: center; gap: 12px; min-height: 60px; padding: 8px 12px; border-bottom: 1px solid var(--line); color: var(--ink); }
+.race-row { display: flex; align-items: center; gap: 18px; min-height: 90px; padding: 12px 18px; border-bottom: 1px solid var(--line); color: var(--ink); }
 .race-row:hover { color: var(--ink); background: #222933; }
-.race-rank { flex: none; width: 30px; height: 30px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;
-  font-family: var(--display); font-size: 19px; font-weight: 800; background: var(--soft); color: var(--muted); }
+.race-name { font-size: 18px; overflow-wrap: anywhere; }
+.race-rank { flex: none; width: 45px; height: 45px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center;
+  font-family: var(--display); font-size: 28px; font-weight: 800; background: var(--soft); color: var(--muted); }
 .race-rank.r1 { background: var(--draw); color: var(--on-light); }
 .race-rank.r2 { background: #c3cad4; color: var(--on-light); }
 .race-rank.r3 { background: #b9804f; color: var(--on-light); }
-.race-rise { font-family: var(--display); font-size: 24px; font-weight: 800; color: var(--green); letter-spacing: 0.02em; }
+.race-rise { flex: none; font-family: var(--display); font-size: 36px; font-weight: 800; color: var(--green); letter-spacing: 0.02em; }
 .panel-note { margin: 0; padding: 8px 12px; font-size: 11px; color: var(--muted); }
