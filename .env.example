# DB (MySQL 8.0, utf8mb4)
DATABASE_URL=mysql+pymysql://clubwire:clubwire@localhost:3306/clubwire?charset=utf8mb4

# 관리자 토큰 서명 키: 32자 이상 임의 값 (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
ADMIN_TOKEN_TTL_MIN=720

# /admin 슈퍼관리자(서버 전용). 팀 운영진 PIN과 별개
SUPER_ADMIN_PIN=7418
SUPER_ADMIN_TOKEN_TTL_MIN=120

# OpenAI (서버에만 둔다. 프론트/레포 금지). 비우면 stub 작성기로 동작
OPENAI_API_KEY=
AI_PROVIDER=auto  # auto: 키 있으면 AI, 없으면 기본형 기사 / openai / template
AI_ARTICLE_MODEL=gpt-4.1-mini
AI_RECAP_MODEL=gpt-4.1-mini

# CORS (React 개발 서버 등, 콤마 구분)
CORS_ORIGINS=http://localhost:5173
