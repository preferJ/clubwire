+INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (15,1,8,NULL,'PRE_MATCH','이채현, 김동근 상대 1승 6패… 설욕할까','이채현은 김동근 상대로 1승 6패. 오늘은 다른 팀으로 갈려 설욕을 노린다.','8월 23일 일요일, YPR 21명이 3개 팀으로 나뉘어 맞붙는다. 게스트 2명도 함께 뛴다.\n\nA팀은 김동근, 김응철, 김현섭 등 7명, B팀은 김병채, 변현우, 손원일 등 7명, C팀은 구대현, 권태홍, 김상균 등 7명으로 꾸려졌다.\n\n이채현은 김동근 상대로 1승 6패. 오늘은 다른 팀으로 갈려 설욕을 노린다. 8월 득점 경쟁이 뜨겁다. 손원일과 이민선이 나란히 7골로 공동 선두다.\n\n이민선(7주), 김응철(5주)과 손원일(4주)이 연속 득점 행진을 이어가고 있다. 안휘진과 이용준은 같은 팀으로 10경기에서 2승에 그쳤다. 오늘은 징크스를 깰 수 있을까.\n\n이채현은 구대현 상대로 3승 8패. 최근 7연패 중이다. 오늘은 다른 팀으로 갈려 설욕을 노린다. 이민선은 구대현 상대로 2승 5패. 최근 3연패 중이다. 오늘은 다른 팀으로 갈려 설욕을 노린다.\n\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v2','ATTENDANCE_STREAK:attendance_streak_v1,CLOSE_MATCH_EXPECTED:close_match_expected_v1,JINX_PAIR:jinx_pair_v1,MILESTONE_EXPECTED:milestone_expected_v1,NEMESIS_MATCH:nemesis_match_v1,RARE_PAIR:rare_pair_v1,RETURN_PLAYER:return_player_v1,SCORING_RACE:scoring_race_v1,SCORING_STREAK:scoring_streak_v1,WIN_STREAK:win_streak_v1','PUBLISHED',1,'2026-08-22 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"김동근\", \"김응철\", \"김현섭\", \"윤기창\", \"윤영문\", \"이민선\", \"이종훈\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"김병채\", \"변현우\", \"손원일\", \"유창우\", \"이채현\", \"진선호\"], \"teamCode\": \"B\", \"guestCount\": 1}, {\"members\": [\"구대현\", \"권태홍\", \"김상균\", \"안휘진\", \"이용준\", \"전원재\"], \"teamCode\": \"C\", \"guestCount\": 1}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 338, \"type\": \"SCORING_RACE\", \"facts\": {\"gap\": 0, \"month\": 8, \"chaser\": {\"name\": \"이민선\", \"memberId\": 15}, \"leader\": {\"name\": \"손원일\", \"memberId\": 1}, \"members\": [{\"name\": \"손원일\", \"memberId\": 1}, {\"name\": \"이민선\", \"memberId\": 15}], \"chaserGoals\": 