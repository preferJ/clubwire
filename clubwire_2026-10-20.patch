+INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (25,1,13,NULL,'PRE_MATCH','유창우·김상균, 징크스 깰까','유창우와 김상균은 같은 팀으로 11경기에서 1승에 그쳤다. 오늘은 징크스를 깰 수 있을까.','9월 27일 일요일, YPR 21명이 3개 팀으로 나뉘어 맞붙는다.\n\nA팀은 김승준, 김현섭, 손원일 등 7명, B팀은 구대현, 김병채, 김응철 등 7명, C팀은 권태홍, 김동근, 김상균 등 7명으로 꾸려졌다.\n\n유창우와 김상균은 같은 팀으로 11경기에서 1승에 그쳤다. 오늘은 징크스를 깰 수 있을까. 이민선(11주), 김응철(9주), 권태홍(8주), 이채현(6주)과 유창우(4주)가 연속 득점 행진을 이어가고 있다.\n\n이용준(13주), 권태홍(13주), 김동근(11주), 윤영문(11주), 김상균(10주)과 이채현(10주)이 개근 행진을 이어가고 있다. 이채현과 김병채는 같은 팀으로 12경기에서 2승에 그쳤다. 오늘은 징크스를 깰 수 있을까.\n\n이종훈과 김병채가 처음으로 같은 팀에서 호흡을 맞춘다. 이채현과 구대현은 8번의 일정 만에 다시 같은 팀이 됐다.\n\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v2','ATTENDANCE_STREAK:attendance_streak_v1,CLOSE_MATCH_EXPECTED:close_match_expected_v1,JINX_PAIR:jinx_pair_v1,MILESTONE_EXPECTED:milestone_expected_v1,RARE_PAIR:rare_pair_v1,SCORING_STREAK:scoring_streak_v1','PUBLISHED',1,'2026-09-26 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"김승준\", \"김현섭\", \"손원일\", \"안휘진\", \"윤영문\", \"이민선\", \"전원재\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"구대현\", \"김병채\", \"김응철\", \"김재홍\", \"윤기창\", \"이종훈\", \"이채현\"], \"teamCode\": \"B\", \"guestCount\": 0}, {\"members\": [\"권태홍\", \"김동근\", \"김상균\", \"박영현\", \"변현우\", \"유창우\", \"이용준\"], \"teamCode\": \"C\", \"guestCount\": 0}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 607, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"김응철\", \"memberId\": 2}, \"streak\": 9, \"teamCode\": \"B\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"김응철\", \"memberId\": 2}, \"category\": \"STREAK\", \"importance\": 90}, {\"id\": 616, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"이민선\", \"memberId\": 15}, \"streak\": 11