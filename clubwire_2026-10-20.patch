+INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (13,1,7,NULL,'PRE_MATCH','8월 득점왕, 손원일·이민선 공동 선두','8월 득점 경쟁이 뜨겁다. 손원일과 이민선이 나란히 5골로 공동 선두다.','8월 16일 일요일, YPR 19명이 3개 팀으로 나뉘어 맞붙는다.\n\nA팀은 김상균, 손원일, 안휘진 등 7명, B팀은 김승준, 김응철, 박영현 등 6명, C팀은 권태홍, 김동근, 김병채 등 6명으로 꾸려졌다.\n\n8월 득점 경쟁이 뜨겁다. 손원일과 이민선이 나란히 5골로 공동 선두다. 김승준은 손원일 상대로 0승 6패. 최근 6연패 중이다. 오늘은 다른 팀으로 갈려 설욕을 노린다.\n\n이민선(6주), 박영현(5주), 김동근(5주)과 김응철(4주)이 연속 득점 행진을 이어가고 있다. 이종훈은 임우철 상대로 1승 5패. 최근 5연패 중이다. 오늘은 다른 팀으로 갈려 설욕을 노린다.\n\n안휘진과 진선호는 같은 팀으로 10경기에서 1승에 그쳤다. 오늘은 징크스를 깰 수 있을까. 김승준은 김동근 상대로 1승 1무 7패. 최근 4연패 중이다. 오늘은 다른 팀으로 갈려 설욕을 노린다.\n\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v2','ATTENDANCE_STREAK:attendance_streak_v1,CLOSE_MATCH_EXPECTED:close_match_expected_v1,JINX_PAIR:jinx_pair_v1,MILESTONE_EXPECTED:milestone_expected_v1,NEMESIS_MATCH:nemesis_match_v1,RARE_PAIR:rare_pair_v1,RETURN_PLAYER:return_player_v1,SCORING_RACE:scoring_race_v1,SCORING_STREAK:scoring_streak_v1','PUBLISHED',1,'2026-08-15 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"김상균\", \"손원일\", \"안휘진\", \"윤영문\", \"이채현\", \"임우철\", \"진선호\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"김승준\", \"김응철\", \"박영현\", \"변현우\", \"이종훈\", \"전원재\"], \"teamCode\": \"B\", \"guestCount\": 0}, {\"members\": [\"권태홍\", \"김동근\", \"김병채\", \"김현섭\", \"이민선\", \"이용준\"], \"teamCode\": \"C\", \"guestCount\": 0}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 257, \"type\": \"NEMESIS_MATCH\", \"facts\": {\"draws\": 0, \"rival\": {\"name\": \"손원일\", \"memberId\": 1}, \"member\": {\"name\": \"김승준\", \"memberId\": 20}, \"members\": [{\"name\": \"김승준\", \"memberId\": 20}, {\"name\": \"손원일\", \"memberId\": 1}], \"rivalWins\": 6, \"teamCount\": 3, \"lossStreak\