-INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (15,1,8,NULL,'PRE_MATCH','김동근·윤영문, 처음으로 한 팀','김동근과 윤영문이 처음으로 같은 팀에서 호흡을 맞춘다.','8월 23일 일요일, YPR 21명이 3개 팀으로 나뉘어 맞붙는다. 게스트 2명도 함께 뛴다.\n\nA팀은 김동근, 김응철, 김현섭 등 7명, B팀은 김병채, 변현우, 손원일 등 7명, C팀은 구대현, 권태홍, 김상균 등 7명으로 꾸려졌다.\n\n김동근과 윤영문이 처음으로 같은 팀에서 호흡을 맞춘다. 이민선(7주), 김응철(5주)과 손원일(4주)이 연속 득점 행진을 이어가고 있다.\n\n손원일, 안휘진, 김상균, 진선호, 이채현과 윤영문은 나란히 3연승을 달리고 있다. 유창우와 진선호는 5번의 일정 만에 다시 같은 팀이 됐다.\n\n안휘진과 권태홍은 5번의 일정 만에 다시 같은 팀이 됐다. 이용준과 구대현은 5번의 일정 만에 다시 같은 팀이 됐다.\n\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v1','CLOSE_MATCH_EXPECTED:close_match_expected_v1,MILESTONE_EXPECTED:milestone_expected_v1,RARE_PAIR:rare_pair_v1,RETURN_PLAYER:return_player_v1,SCORING_STREAK:scoring_streak_v1,WIN_STREAK:win_streak_v1','PUBLISHED',1,'2026-08-22 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"김동근\", \"김응철\", \"김현섭\", \"윤기창\", \"윤영문\", \"이민선\", \"이종훈\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"김병채\", \"변현우\", \"손원일\", \"유창우\", \"이채현\", \"진선호\"], \"teamCode\": \"B\", \"guestCount\": 1}, {\"members\": [\"구대현\", \"권태홍\", \"김상균\", \"안휘진\", \"이용준\", \"전원재\"], \"teamCode\": \"C\", \"guestCount\": 1}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 246, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"이민선\", \"memberId\": 15}, \"streak\": 7, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"이민선\", \"memberId\": 15}, \"category\": \"STREAK\", \"importance\": 77}, {\"id\": 238, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"김응철\", \"memberId\": 2}, \"streak\": 5, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"김응철\", \"memberId\": 2}, \"category\":