+INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (5,1,3,NULL,'PRE_MATCH','손원일·권태홍, 징크스 깰까','손원일과 권태홍은 같은 팀으로 11경기에서 2승에 그쳤다. 오늘은 징크스를 깰 수 있을까.','7월 19일 일요일, YPR 20명이 3개 팀으로 나뉘어 맞붙는다. 게스트 2명도 함께 뛴다.\n\nA팀은 구대현, 김동근, 김재홍 등 7명, B팀은 권태홍, 김승준, 변현우 등 7명, C팀은 김병채, 김응철, 박영현 등 6명으로 꾸려졌다.\n\n손원일과 권태홍은 같은 팀으로 11경기에서 2승에 그쳤다. 오늘은 징크스를 깰 수 있을까. 김승준은 오늘이 기록 집계 후 첫 출전이다.\n\n이종훈과 구대현은 같은 팀으로 11경기에서 3승에 그쳤다. 오늘은 징크스를 깰 수 있을까. 안휘진은 통산 10골까지 2골만 남겨 두었다.\n\n팀 간 전력이 고르게 나뉘어 어느 팀도 쉽게 승리를 장담하기 어렵다.\n\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v2','CLOSE_MATCH_EXPECTED:close_match_expected_v1,FIRST_APPEARANCE:first_appearance_v1,JINX_PAIR:jinx_pair_v1,MILESTONE_EXPECTED:milestone_expected_v1','PUBLISHED',1,'2026-07-18 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"구대현\", \"김동근\", \"김재홍\", \"유창우\", \"이종훈\", \"임우철\"], \"teamCode\": \"A\", \"guestCount\": 1}, {\"members\": [\"권태홍\", \"김승준\", \"변현우\", \"손원일\", \"이용준\", \"진선호\"], \"teamCode\": \"B\", \"guestCount\": 1}, {\"members\": [\"김병채\", \"김응철\", \"박영현\", \"안휘진\", \"윤영문\", \"이민선\"], \"teamCode\": \"C\", \"guestCount\": 0}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 72, \"type\": \"JINX_PAIR\", \"facts\": {\"members\": [{\"name\": \"손원일\", \"memberId\": 1}, {\"name\": \"권태홍\", \"memberId\": 16}], \"teamCode\": \"B\", \"sameTeamWins\": 2, \"sameTeamDraws\": 6, \"sameTeamLosses\": 3, \"winRatePercent\": 18, \"sameTeamMatches\": 11}, \"subject\": {\"name\": \"손원일\", \"memberId\": 1}, \"category\": \"PAIR\", \"importance\": 57}, {\"id\": 71, \"type\": \"FIRST_APPEARANCE\", \"facts\": {\"member\": {\"name\": \"김승준\", \"memberId\": 20}, \"teamCode\": \"B\", \"firstAppearance\": true}, \"subject\": {\"name\": \"김승준\", \"memberId\": 20}, \"category\": \"PLAYER\", \"importance\": 50}, {\"id\": 73, \"type\": \"JINX_PAIR\", \"facts\": {\"members\": [{\"name\": \"이종훈\", \"memberId\": 8}, {\"name\": \"구대현\", \"memberId\": 22}], \"teamCode\": \"A\", \"sameTeamWins\": 3, \"sameTeamDraws\": 3, \"sameTeamLosses\": 5, \"winRatePercent\": 27, \"sameTeamMatches\": 11}, \"subject\": {\"name\": \"이종훈\", \"memberId\": 8}, \"category\": \"PAIR\", \"importance\": 48}, {\"id\": 70, \"type\": \"MILESTONE_EXPECTED\", \"facts\": {\"member\": {\"name\": \"안휘진\", \"memberId\": 3}, \"metric\": \"goals\", \"current\": 8, \"teamCode\": \"C\", \"milestone\": 10, \"remaining\": 2, \"metricLabel\": \"골\"}, \"subject\": {\"name\": \"안휘진\", \"memberId\": 3}, \"category\": \"MILESTONE\", \"importance\": 45}, {\"id\": 74, \"type\": \"CLOSE_MATCH_EXPECTED\", \"facts\": {\"balanced\": true, \"teamCodes\": [\"A\", \"B\", \"C\"]}, \"subject\": null, \"category\": \"MATCH\", \"importance\": 45}], \"location\": null, \"articleType\": \"PRE_MATCH\", \"sessionDate\": \"2026-07-19\", \"sessionTitle\": \"일요 정기 경기\"}','{\"body\": \"7월 19일 일요일, YPR 20명이 3개 팀으로 나뉘어 맞붙는다. 게스트 2명도 함께 뛴다.\\n\\nA팀은 구대현, 김동근, 김재홍 등 7명, B팀은 권태홍, 김승준, 변현우 등 7명, C팀은 김병채, 김응철, 박영현 등 6명으로 꾸려졌다.\\n\\n손원일과 권태홍은 같은 팀으로 11경기에서 2승에 그쳤다. 오늘은 징크스를 깰 수 있을까. 김승준은 오늘이 기록 집계 후 첫 출전이다.\\n\\n이종훈과 구대현은 같은 팀으로 11경기에서 3승에 그쳤다. 오늘은 징크스를 깰 수 있을까. 안휘진은 통산 10골까지 2골만 남겨 두었다.\\n\\n팀 간 전력이 고르게 나뉘어 어느 팀도 쉽게 승리를 장담하기 어렵다.\\n\\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.\", \"title\": \"손원일·권태홍, 징크스 깰까\", \"summary\": \"손원일과 권태홍은 같은 팀으로 11경기에서 2승에 그쳤다. 오늘은 징크스를 깰 수 있을까.\", \"usedInsightIds\": [72, 71, 73, 70, 74]}',NULL,'2026-07-18 22:46:00.000','2026-07-18 22:40:00.000'),(6,1,3,NULL,'SESSION_RECAP','유창우→김재홍, 오늘만 두 번','유창우의 패스를 김재홍이 마무리한 골이 오늘만 두 번 나왔다.','7월 19일 YPR은 7경기를 치르며 총 20골을 기록했다. A팀이 3승 0무 2패로 가장 많은 승리를 챙겼다.\n\n득점 순위에서는 김재홍(4골), 권태홍(3골), 진선호(2골) 순으로 앞섰다.\n\n유창우의 패스를 김재홍이 마무리한 골이 오늘만 두 번 나왔다. 4경기는 권태홍의 발끝에서 갈렸다. 종료 34초를 남기고 터진 결승골이었다.\n\n7경기는 구대현의 발끝에서 갈렸다. 종료 57초를 남기고 터진 결승골이었다. 유창우, 김동근, 임우철과 윤영문이 나란히 통산 10경기 출전 고지를 밟았다.\n\n김재홍이 이주의 MVP에 이름을 올렸다. 김재홍이 이주의 득점왕(4골)에 이름을 올렸다.\n\n1경기  A 4 : 2 B\n2경기  A 3 : 1 C\n3경기  C 1 : 0 B\n4경기  B 1 : 0 A\n5경기  A 1 : 2 C\n6경기  C 1 : 1 B\n7경기  B 1 : 2 A','sample-template','wire_prompt_v2','ASSIST_COMBO:assist_combo_v1,FIRST_ASSIST:first_assist_v1,LATE_WINNER:late_winner_v1,MILESTONE_ACHIEVED:milestone_achieved_v1,SCORING_STREAK:scoring_streak_v1,TITLE_AWARDED:title_awarded_v1','PUBLISHED',1,'2026-07-19 01:18:40.000',NULL,1,'{\"clubName\": \"YPR\", \"insights\": [{\"id\": 75, \"type\": \"LATE_WINNER\", \"facts\": {\"teamA\": \"B\", \"teamB\": \"A\", \"assist\": {\"name\": \"손원일\", \"memberId\": 1}, \"gameNo\": 4, \"member\": {\"name\": \"권태홍\", \"memberId\": 16}, \"scoreA\": 1, \"scoreB\": 0, \"winnerTeam\": \"B\", \"remainingSec\": 34, \"inStoppageTime\": false}, \"subject\": {\"name\": \"권태홍\", \"memberId\": 16}, \"category\": \"MATCH\", \"importance\": 75}, {\"id\": 76, \"type\": \"LATE_WINNER\", \"facts\": {\"teamA\": \"B\", \"teamB\": \"A\", \"gameNo\": 7, \"member\": {\"name\": \"구대현\", \"memberId\": 22}, \"scoreA\": 1, \"scoreB\": 2, \"winnerTeam\": \"A\", \"remainingSec\": 57, \"inStoppageTime\": false}, \"subject\": {\"name\": \"구대현\", \"memberId\": 22}, \"category\": \"MATCH\", \"importance\": 62}, {\"id\": 78, \"type\": \"MILESTONE_ACHIEVED\", \"facts\": {\"total\": 10, \"member\": {\"name\": \"유창우\", \"memberId\": 4}, \"metric\": \"games\", \"milestone\": 10, \"metricLabel\": \"출전 경기\"}, \"subject\": {\"name\": \"유창우\", \"memberId\": 4}, \"category\": \"MILESTONE\", \"importance\": 55}, {\"id\": 81, \"type\": \"MILESTONE_ACHIEVED\", \"facts\": {\"total\": 11, \"member\": {\"name\": \"김동근\", \"memberId\": 14}, \"metric\": \"games\", \"milestone\": 10, \"metricLabel\": \"출전 경기\"}, \"subject\": {\"name\": \"김동근\", \"memberId\": 14}, \"category\": \"MILESTONE\", \"importance\": 55}, {\"id\": 85, \"type\": \"MILESTONE_ACHIEVED\", \"facts\": {\"total\": 11, \"member\": {\"name\": \"임우철\", \"memberId\": 18}, \"metri