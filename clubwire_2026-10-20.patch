-INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (23,1,12,NULL,'PRE_MATCH','김재홍, 49일 만의 복귀','김재홍이 49일 만에 다시 그라운드를 밟는다.','9월 20일 일요일, YPR 18명이 3개 팀으로 나뉘어 맞붙는다. 게스트 1명도 함께 뛴다.\n\nA팀은 권태홍, 김응철, 김재홍 등 6명, B팀은 구대현, 김상균, 김승준 등 6명, C팀은 김동근, 김병채, 박영현 등 6명으로 꾸려졌다.\n\n김재홍이 49일 만에 다시 그라운드를 밟는다. 김응철(8주), 권태홍(7주), 이채현(5주)과 전원재(3주)가 연속 득점 행진을 이어가고 있다.\n\n이용준과 김승준은 7번의 일정 만에 다시 같은 팀이 됐다. 김응철과 이채현은 6번의 일정 만에 다시 같은 팀이 됐다.\n\n임우철은 통산 50경기 출전까지 2경기만 남겨 두었다. 김병채는 통산 50경기 출전까지 3경기만 남겨 두었다.\n\n누가 오늘의 주인공이 될지는 마감 기사에서 확인할 수 있다.','sample-template','wire_prompt_v1','CLOSE_MATCH_EXPECTED:close_match_expected_v1,MILESTONE_EXPECTED:milestone_expected_v1,RARE_PAIR:rare_pair_v1,RETURN_PLAYER:return_player_v1,SCORING_STREAK:scoring_streak_v1','PUBLISHED',1,'2026-09-19 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"권태홍\", \"김응철\", \"김재홍\", \"윤영문\", \"이채현\", \"전원재\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"구대현\", \"김상균\", \"김승준\", \"김현섭\", \"안휘진\", \"이용준\"], \"teamCode\": \"B\", \"guestCount\": 0}, {\"members\": [\"김동근\", \"김병채\", \"박영현\", \"임우철\", \"진선호\"], \"teamCode\": \"C\", \"guestCount\": 1}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 387, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"김응철\", \"memberId\": 2}, \"streak\": 8, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"김응철\", \"memberId\": 2}, \"category\": \"STREAK\", \"importance\": 85}, {\"id\": 395, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"권태홍\", \"memberId\": 16}, \"streak\": 7, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"권태홍\", \"memberId\": 16}, \"category\": \"STREAK\", \"importance\": 77}, {\"id\": 398, \"type\": \