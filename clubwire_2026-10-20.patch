+INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (26,1,13,NULL,'SESSION_RECAP','이민선, 12주 연속 골','이민선(12주), 김응철(10주), 권태홍(9주), 이채현(7주), 유창우(5주), 전원재(5주)와 김현섭(4주)이 연속 골 행진을 이어갔다.','9월 27일 YPR은 9경기를 치르며 총 29골을 기록했다. A팀이 2승 3무 1패로 가장 많은 승리를 챙겼다.\n\n득점 순위에서는 유창우(4골), 김현섭(3골), 안휘진(2골) 순으로 앞섰다.\n\n이민선(12주), 김응철(10주), 권태홍(9주), 이채현(7주), 유창우(5주), 전원재(5주)와 김현섭(4주)이 연속 골 행진을 이어갔다. 이종훈 등 5명이 통산 50경기 출전 고지를 밟았다.\n\n윤기창이 통산 30경기 출전 고지를 밟았다. 안휘진이 통산 10도움 고지를 밟았다.\n\n김상균이 통산 10골 고지를 밟았다.\n\n1경기  A 1 : 1 B\n2경기  B 1 : 1 C\n3경기  C 3 : 4 A\n4경기  A 3 : 2 B\n5경기  B 1 : 1 C\n6경기  C 1 : 1 A\n7경기  A 0 : 0 B\n8경기  B 2 : 4 C\n9경기  C 2 : 1 A','sample-template','wire_prompt_v2','MILESTONE_ACHIEVED:milestone_achieved_v1,SCORING_STREAK:scoring_streak_v1,TITLE_AWARDED:title_awarded_v1','GENERATED',0,NULL,NULL,1,'{\"clubName\": \"YPR\", \"insights\": [{\"id\": 638, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"김응철\", \"memberId\": 2}, \"streak\": 10, \"goalsToday\": 1, \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"김응철\", \"memberId\": 2}, \"category\": \"STREAK\", \"importance\": 90}, {\"id\": 655, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"이민선\", \"memberId\": 15}, \"streak\": 12, \"goalsToday\": 1, \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"이민선\", \"memberId\": 15}, \"category\": \"STREAK\", \"importance\": 90}, {\"id\": 656, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"권태홍\", \"memberId\": 16}, \"streak\": 9, \"goalsToday\": 2, \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"권태홍\", \"memberId\": 16}, \"category\": \"STREAK\", \"importance\": 90}, {\"id\": 657, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\":