+INSERT INTO `AI_ARTICLE` (`ARTICLE_ID`, `CLUB_ID`, `SESSION_ID`, `MATCH_ID`, `ARTICLE_TYPE`, `TITLE`, `SUMMARY`, `CONTENT`, `MODEL_NAME`, `PROMPT_VERSION`, `INSIGHT_RULE_VERSION`, `STATUS`, `PUBLISHED_YN`, `PUBLISHED_AT`, `PARENT_ARTICLE_ID`, `GENERATION_NO`, `REQUEST_JSON`, `RESPONSE_JSON`, `ERROR_MESSAGE`, `UPDATED_AT`, `CREATED_AT`) VALUES (7,1,4,NULL,'PRE_MATCH','오늘은 접전 예고','팀 간 전력이 고르게 나뉘어 어느 팀도 쉽게 승리를 장담하기 어렵다.','7월 26일 일요일, YPR 20명이 3개 팀으로 나뉘어 맞붙는다.\n\nA팀은 김승준, 김재홍, 박영현 등 7명, B팀은 구대현, 김병채, 변현우 등 7명, C팀은 권태홍, 김동근, 김상균 등 6명으로 꾸려졌다.\n\n팀 간 전력이 고르게 나뉘어 어느 팀도 쉽게 승리를 장담하기 어렵다. 안휘진, 이종훈, 김재홍, 이민선, 권태홍과 진선호는 나란히 3주 연속으로 골 맛을 보고 있다.\n\n안휘진은 통산 10골까지 1골만 남겨 두었다. 박영현은 통산 10경기 출전까지 3경기만 남겨 두었다.\n\n7월 득점 경쟁이 뜨겁다. 안휘진이 9골, 김재홍이 7골로 2골 차다.\n\n경기 결과와 오늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v2','CLOSE_MATCH_EXPECTED:close_match_expected_v1,MILESTONE_EXPECTED:milestone_expected_v1,SCORING_RACE:scoring_race_v1,SCORING_STREAK:scoring_streak_v1','PUBLISHED',1,'2026-07-25 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"김승준\", \"김재홍\", \"박영현\", \"안휘진\", \"윤영문\", \"이종훈\", \"진선호\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"구대현\", \"김병채\", \"변현우\", \"손원일\", \"유창우\", \"이민선\", \"임우철\"], \"teamCode\": \"B\", \"guestCount\": 0}, {\"members\": [\"권태홍\", \"김동근\", \"김상균\", \"김응철\", \"이용준\", \"이채현\"], \"teamCode\": \"C\", \"guestCount\": 0}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 102, \"type\": \"CLOSE_MATCH_EXPECTED\", \"facts\": {\"balanced\": true, \"teamCodes\": [\"A\", \"B\", \"C\"]}, \"subject\": null, \"category\": \"MATCH\", \"importance\": 48}, {\"id\": 93, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"안휘진\", \"memberId\": 3}, \"streak\": 3, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"안휘진\", \"memberId\": 3}, \"category\": \"STREAK\", \"importance\": 45}, {\"id\": 94, \"type\": \"MILESTONE_EXPECTED\", \"facts\": {\"member\": {\"name\": \"안휘진\", \"memberId\": 3}, \"metric\": \"goals\", \"curr