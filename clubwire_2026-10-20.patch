늘의 주인공은 마감 기사에서 전한다.','sample-template','wire_prompt_v1','CLOSE_MATCH_EXPECTED:close_match_expected_v1,MILESTONE_EXPECTED:milestone_expected_v1,SCORING_STREAK:scoring_streak_v1','PUBLISHED',1,'2026-07-25 22:46:00.000',NULL,1,'{\"teams\": [{\"members\": [\"김승준\", \"김재홍\", \"박영현\", \"안휘진\", \"윤영문\", \"이종훈\", \"진선호\"], \"teamCode\": \"A\", \"guestCount\": 0}, {\"members\": [\"구대현\", \"김병채\", \"변현우\", \"손원일\", \"유창우\", \"이민선\", \"임우철\"], \"teamCode\": \"B\", \"guestCount\": 0}, {\"members\": [\"권태홍\", \"김동근\", \"김상균\", \"김응철\", \"이용준\", \"이채현\"], \"teamCode\": \"C\", \"guestCount\": 0}], \"clubName\": \"YPR\", \"insights\": [{\"id\": 84, \"type\": \"CLOSE_MATCH_EXPECTED\", \"facts\": {\"balanced\": true, \"teamCodes\": [\"A\", \"B\", \"C\"]}, \"subject\": null, \"category\": \"MATCH\", \"importance\": 48}, {\"id\": 76, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"안휘진\", \"memberId\": 3}, \"streak\": 3, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"안휘진\", \"memberId\": 3}, \"category\": \"STREAK\", \"importance\": 45}, {\"id\": 77, \"type\": \"MILESTONE_EXPECTED\", \"facts\": {\"member\": {\"name\": \"안휘진\", \"memberId\": 3}, \"metric\": \"goals\", \"current\": 9, \"teamCode\": \"A\", \"milestone\": 10, \"remaining\": 1, \"metricLabel\": \"골\"}, \"subject\": {\"name\": \"안휘진\", \"memberId\": 3}, \"category\": \"MILESTONE\", \"importance\": 45}, {\"id\": 78, \"type\": \"SCORING_STREAK\", \"facts\": {\"member\": {\"name\": \"이종훈\", \"memberId\": 8}, \"streak\": 3, \"teamCode\": \"A\", \"streakUnit\": \"일정\"}, \"subject\": {\"name\": \"이종훈\", \"memberId\": 8}, \"category\": \"STREAK\", \"importance\": 45}, {\"id\": 79, \"type\": \"MILESTONE_EXPECTED\", \"facts\": {\"member\": {\"name\": \"박영현\", \"memberId\": 10}, \"metric\": \"games\", \"current\": 7, \"teamCode\": \"A\", \"milestone\": 10, \"remaining\": 3, \"metricLabel\": \"출전 경기\"}, \"subject\": {\"name\": \"박영현\", \"memberId\": 10}, \"category\": \"MILESTONE\", \"importa